# System directories.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Application directories.
export CLAUDE_CONFIG_DIR="$XDG_CONFIG_HOME/claude"
export NVM_DIR="$XDG_CONFIG_HOME/nvm"
export OBSIDIAN_VAULT_DIR="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents"

# User directories.
export PROJECTS_DIR="$HOME/projects"
export DOTFILES_DIR="$(chezmoi source-path 2>/dev/null || echo "$PROJECTS_DIR/nickcorin/dotfiles")"
export GOPATH="$PROJECTS_DIR/go"
export GOBIN="$GOPATH/bin"

# System variables.
export EDITOR="nvim"
export HISTFILE="$HOME/.zsh_history"
export LANG=en_US.UTF-8
export PROFILE="$HOME/.zshrc"
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"


# Configure the PATH.
#
# We prepend directories to PATH, then let `typeset -U` keep the array unique.
typeset -U path
path=(
    "$HOME/.cargo/bin"
    "$HOME/.lmstudio/bin"
    "$HOME/.local/bin"
    "$HOME/.bun/bin"
    "/Applications/Obsidian.app/Contents/MacOS"
    "$GOBIN"
    /usr/local/opt/llvm/bin
    $path
)
export PATH
