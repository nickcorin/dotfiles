      "Red": "#ac4242",
      "Bright Red": "#c55555",
      "Green": "#90a959",
      "Bright Green": "#aac474",
      "Yellow": "#f4bf75",
      "Bright Yellow": "#feca88",
      "Blue": "#6a9fb5",
      "Bright Blue": "#82b8c8",
      "Magenta": "#aa759f",
      "Bright Magenta": "#c28cb8",
      "Cyan": "#75b5aa",
      "Bright Cyan": "#93d3c3"
    }
  }
}
